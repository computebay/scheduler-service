generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["scheduler"]
}

model Node {
  id                  String     @id
  orgId               String?    // Set by dashboard on pairing; "unpaired" for PENDING
  name                String?
  region              String?
  status              NodeStatus @default(REGISTERED)
  publicKey           String?    // Required after registration; never overwrite unless revoked
  machineId           String?
  agentVersion        String?

  totalCpu            Int
  totalMemoryMb       Int
  allocatableCpu      Int?       // From registration; used for scheduling
  allocatableMemoryMb Int?

  // GPU discovery (reported by the worker at registration/heartbeats)
  gpuAvailable        Boolean    @default(false) // Hardware detected; not an execution-readiness claim
  gpuName             String?    // Name of the first detected GPU (e.g. "NVIDIA A100")
  gpuCount            Int        @default(0)
  gpuMemoryMb         Int?       // Total VRAM across all detected GPUs, in MiB; null if any value is unknown
  gpuDriverVersion    String?
  gpuSpecs            Json?      // Full per-GPU details: [{ index, vendor, name, memoryMb, pciAddress, ... }]
  gpuMetadataComplete Boolean    @default(false) // Model, VRAM and driver known for every GPU
  gpuExecutionReady   Boolean    @default(false) // An execution backend has been verified

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  lastHeartbeatAt     DateTime?

  capacitySnapshots   NodeCapacitySnapshot[]

  @@index([orgId])
  @@index([status])
  @@index([machineId])
  @@index([gpuAvailable])
  @@schema("scheduler")
}

model NodeCapacitySnapshot {
  id            String   @id @default(uuid())
  nodeId        String
  usedCpu       Int
  usedMemoryMb  Int
  recordedAt    DateTime @default(now())

  node          Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@schema("scheduler")
}

model SchedulingAudit {
  id          String   @id @default(uuid())
  jobId       String
  nodeId      String
  decision    SchedulingDecision
  reason      String?
  createdAt   DateTime @default(now())

  @@index([jobId])
  @@index([nodeId])
  @@schema("scheduler")
}

enum NodeStatus {
  REGISTERED
  HEALTHY
  UNHEALTHY
  DRAINING
  OFFLINE

  @@schema("scheduler")
}

enum SchedulingDecision {
  SCHEDULED
  REJECTED_NO_CAPACITY
  REJECTED_NO_HEALTHY_NODE
  RESCHEDULED

  @@schema("scheduler")
}